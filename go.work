go 1.26.0

// The replace directives below are written by gofs-require.sh: they replace
// the go-fs version cmd/gofs requires with the module directories, because
// the go command reads the go.mod files of that version even for workspace
// modules, and the release PR requires it before it is tagged.

use (
	.
	./azureblobfs
	./cmd/gofs
	./dropboxfs
	./ftpfs
	./gitfs
	./s3fs
	./sftpfs
	./smbfs
	./tools
	./webdavfs
)

replace github.com/ungerik/go-fs v1.0.0-rc.8 => .

replace github.com/ungerik/go-fs/azureblobfs v1.0.0-rc.8 => ./azureblobfs

replace github.com/ungerik/go-fs/dropboxfs v1.0.0-rc.8 => ./dropboxfs

replace github.com/ungerik/go-fs/ftpfs v1.0.0-rc.8 => ./ftpfs

replace github.com/ungerik/go-fs/s3fs v1.0.0-rc.8 => ./s3fs

replace github.com/ungerik/go-fs/sftpfs v1.0.0-rc.8 => ./sftpfs

replace github.com/ungerik/go-fs/smbfs v1.0.0-rc.8 => ./smbfs

replace github.com/ungerik/go-fs/webdavfs v1.0.0-rc.8 => ./webdavfs
